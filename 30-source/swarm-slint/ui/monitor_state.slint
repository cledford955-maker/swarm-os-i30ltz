export struct ProcessRow {
    pid: int,
    name: string,
    memory-label: string,
}

export global MonitorState {
    // Pre-formatted by Rust from LucyServer's actual SystemStats shape
    // (CpuUsagePercentage / TotalMemoryMb / UsedMemoryMb / FreeMemoryMb —
    // there is NO disk-usage field on LucyServer today, so none is shown here).
    in property <string> cpu-label: "CPU  --%";
    in property <string> ram-label: "RAM  --/-- MB";
    in property <string> engine-label: "ENGINE  --";
    in property <bool> engine-online: false;
    in property <string> lucy-label: "LUCY  --";
    in property <bool> lucy-online: false;
    in property <string> phone-label: "PHONE  --";
    in property <bool> phone-online: false;

    in property <[ProcessRow]> processes: [];

    callback kill-process(int);
}
