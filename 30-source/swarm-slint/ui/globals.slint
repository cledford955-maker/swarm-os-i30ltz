// SWARM OS design tokens — import this in every .slint file
export global SwarmTheme {
    out property <color> bg:          #0d0d0d;
    out property <color> surface:     #141414;
    out property <color> card:        #1a1a1a;
    out property <color> border:      #2a2a2a;
    out property <color> accent:      #76b900;
    out property <color> accent-hover:#8ed600;
    out property <color> text:        #e0e0e0;
    out property <color> text-dim:    #808080;
    out property <color> text-bright: #ffffff;
    out property <color> danger:      #e05252;
    out property <color> warn:        #e0a020;

    out property <length> radius:     6px;
    out property <length> top-bar-h:  48px;
    out property <length> sidebar-w:  64px;
}
