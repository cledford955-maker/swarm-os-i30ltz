#!/bin/sh
set -eu
# Local kernels remain generated by the distribution's own GRUB script.
. /etc/default/grub
local_os=${SWARM_MENU_LOCAL:-cachyos}
case "$local_os" in
 cachyos) title=CachyOS; class=cachyos ;;
 swarm_os) title='SWARM OS'; class=swarm_os ;;
 *) echo 'Unknown SWARM_MENU_LOCAL' >&2; exit 1 ;;
esac
printf 'submenu "%s" --class %s --id swarm-native {\n' "$title" "$class"
sh /etc/grub.d/10_linux
printf '}\n'
if [ "$local_os" != cachyos ]; then
cat <<'GRUB'
menuentry 'CachyOS' --class cachyos --id swarm-cachyos {
 insmod btrfs
 search --no-floppy --fs-uuid --set=other_os ef9acba2-3816-4fd7-bdd7-a9526816d3f0
 configfile ($other_os)/@/boot/grub/grub.cfg
}
GRUB
fi
if [ "$local_os" != swarm_os ]; then
cat <<'GRUB'
menuentry 'SWARM OS' --class swarm_os --id swarm-swarmos {
 insmod btrfs
 search --no-floppy --fs-uuid --set=other_os 366134c3-3986-4475-b9de-4707d582656e
 configfile ($other_os)/@/boot/grub/grub.cfg
}
GRUB
fi
cat <<'GRUB'
menuentry 'EndeavourOS' --class endeavouros --id swarm-endeavour {
 insmod btrfs
 search --no-floppy --fs-uuid --set=other_os 0ac123f1-bbd1-4ea6-8fdd-930bd0d45e18
 configfile ($other_os)/@/boot/grub/grub.cfg
}
menuentry 'Ventoy' --class ventoy --id swarm-ventoy {
 if [ "$grub_platform" = efi ]; then
  insmod fat
  insmod chain
  # Try known UUID first; fall back to standard Ventoy EFI label
  if search --no-floppy --fs-uuid --set=ventoy_efi E039-AD96; then
   true
  elif search --no-floppy --label --set=ventoy_efi VTOYEFI; then
   true
  else
   echo ''
   echo '  ERROR: Ventoy EFI partition not found.'
   echo '  UUID E039-AD96 and label VTOYEFI both missing.'
   echo '  Run from a booted OS:'
   echo '    sudo blkid | grep -i ventoy'
   echo '  Then update 09_swarm_multiboot UUID and reinstall themes.'
   echo ''
   sleep 10
   exit
  fi
  # --force bypasses GRUB signature check; required on many UEFI boards
  if [ -f ($ventoy_efi)/EFI/BOOT/BOOTX64.EFI ]; then
   chainloader --force ($ventoy_efi)/EFI/BOOT/BOOTX64.EFI
  elif [ -f ($ventoy_efi)/EFI/ventoy/grubx64.efi ]; then
   chainloader --force ($ventoy_efi)/EFI/ventoy/grubx64.efi
  else
   echo ''
   echo '  ERROR: Ventoy EFI binary missing on the found partition.'
   echo '  Expected: /EFI/BOOT/BOOTX64.EFI or /EFI/ventoy/grubx64.efi'
   echo '  Ventoy may need reinstalling to this drive.'
   echo ''
   sleep 10
   exit
  fi
 else
  echo 'Ventoy entry requires UEFI mode.'
  sleep 5
 fi
}
GRUB
