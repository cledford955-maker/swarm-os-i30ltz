# ===== Containers (rootless Podman) / Sandboxing / Hardening =====
# Task #2 (Podman rootless containers) + Task #3 (harden baseline) from the
# SWARM OS journey roadmap. shadow (in base) already ships newuidmap/newgidmap
# on Arch, so no separate "uidmap" package is needed for user namespaces.
podman
# provides /usr/bin/docker shim so DOCKER_HOST tooling "just works"
podman-docker
crun
fuse-overlayfs
slirp4netns
netavark
aardvark-dns
catatonit
# sandbox isolation for GUI apps launched from the hex desktop
firejail
# MAC confinement for gaming-agent/lucy-server + apps
apparmor
# tailscale — REMOVED 2026-09-11: not in [core]/[extra] (this profile's
# pacman.conf has no AUR/CachyOS repos), AUR-only on vanilla Arch. Adding it
# broke pacstrap ("failed to install packages to new root") on the first real
# build attempt after this session's changes. The nftables.conf iif
# "tailscale0" rule stays a no-op until tailscale is installed some other way
# — e.g. a first-boot script running tailscale's own install.sh, same pattern
# as swarm-ollama-pull.sh in install_swarm_os.sh — not via packages.x86_64.
# kept installed for manual/ad-hoc use; NOT enabled by default — nftables.conf
# is the real firewall (default-drop, see file); enabling ufw's own backend
# alongside it would fight over the same netfilter tables
ufw

# ===== General Utilities =====
rsync
tmux
htop
curl
wget
unzip
git
diffutils
gptfdisk
parted
reflector
mkinitcpio

# ===== GUI apps launched from the hex desktop =====
# system_launcher.dart's fallback chains referenced these before they were
# ever added here, so every "Launching..." tap silently failed — none of
# terminalCmd/browserCmd's candidates existed on the built ISO. alacritty is
# the first choice in every terminal fallback chain; chromium is used instead
# of google-chrome-stable for the browser tile because google-chrome is
# AUR-only and this profile's pacman.conf has no AUR repo configured (see the
# tailscale removal note above — an AUR-only package here breaks pacstrap).
alacritty
foot
chromium
# file manager for the Files tile (fileManagerCmd in system_launcher.dart)
thunar
# system monitor for the Monitor tile (monitorCmd uses btop first)
btop
# nodejs/npm — lets `npm install -g @anthropic-ai/claude-code` provide the
# `claude` CLI that the CC tile shells out to (claudeCodeCmd in
# system_launcher.dart). The CLI itself isn't packaged here since it's a
# per-user, auth-gated install, not a system package.
nodejs
npm

# ===== Live ISO Boot Requirements =====
mkinitcpio-archiso
mkinitcpio-nfs-utils
arch-install-scripts
syslinux
memtest86+
memtest86+-efi
edk2-shell

os-prober

# Sealed-secret unsealing at boot (swarm-secrets.service, 2026-09-12).
# Explicit rather than relying on it arriving as a pacman dependency.
gnupg
