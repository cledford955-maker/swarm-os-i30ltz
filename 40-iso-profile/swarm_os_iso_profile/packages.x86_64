# ===== Desktop compositor (labwc) + Flutter hex-grid shell =====
# Reverted from the Slint/backend-linuxkms detour (see SWARM_AI_FEATURES.md
# architecture pivot note, 2026-09-11) — the existing Flutter app already
# implements the intended honeycomb hex-grid desktop; it just needs a real
# compositor so Chrome/Antigravity/Claude/etc can run alongside it as normal
# windows, which backend-linuxkms could never do (no compositor at all).
# lightweight wlroots floating-window compositor
labwc
# provides libseat.so — used via LIBSEAT_BACKEND=logind
seatd
libxkbcommon
# XWayland keyboard handling — safety net if Flutter's GTK embedder needs
# the X11 fallback path (see swarm-ui.service)
libxkbcommon-x11
libinput
libdrm
# EGL/Wayland platform for Mesa — needed for GTK/Flutter GL context creation
# when running natively under a Wayland compositor
egl-wayland
libglvnd
wayland
wayland-protocols
# X11 compatibility layer under labwc, in case Flutter's GTK3 embedder's
# native-Wayland GDK backend has issues (uncomment GDK_BACKEND=x11 in
# swarm-ui.service to force this path)
xorg-xwayland
mesa
vulkan-icd-loader
vulkan-radeon
vulkan-intel
intel-media-driver
libva-mesa-driver
zram-generator
nftables
bc

