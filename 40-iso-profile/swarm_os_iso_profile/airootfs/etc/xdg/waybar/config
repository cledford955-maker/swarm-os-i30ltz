// SWARM OS — waybar taskbar for labwc.
//
// labwc has no built-in panel; this JSON5 config gives the desktop a window
// switcher strip plus system tray, clock, battery, network. The strip
// deliberately lives at the BOTTOM so it doesn't fight the Flutter shell's
// own top bar. Height stays small (24 px) so the hex-grid desktop keeps
// most of the screen.
//
// wlr-based modules (wlr/workspaces, wlr/taskbar) rely on the wlr-foreign-
// toplevel-management protocol which labwc implements — no extension needed.
{
    "position": "bottom",
    "height": 24,
    "spacing": 6,
    "layer": "top",

    "modules-left": ["wlr/workspaces", "wlr/taskbar"],
    "modules-center": ["clock"],
    "modules-right": ["network", "pulseaudio", "battery", "temperature", "tray"],

    "wlr/workspaces": {
        "on-click": "activate",
        "sort-by-number": true,
        "format": "{name}"
    },

    "wlr/taskbar": {
        // Short title, icon-first, click to focus, middle-click to close.
        "format": "{icon} {title:.30}",
        "icon-size": 16,
        "tooltip-format": "{title}",
        "on-click": "activate",
        "on-click-middle": "close",
        "ignore-list": [
            // The Flutter shell IS the desktop; do not list it as a switchable
            // window (matches xdg app_id).
            "swarm_flutter",
            "com.swarmos.swarm_flutter"
        ]
    },

    "clock": {
        "format": "{:%a %b %d  %H:%M}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },

    "battery": {
        "states": { "warning": 25, "critical": 10 },
        "format": "{icon} {capacity}%",
        "format-charging": "⚡ {capacity}%",
        "format-plugged": "🔌 {capacity}%",
        "format-icons": ["", "", "", "", ""]
    },

    "network": {
        "interval": 5,
        "format-wifi": " {essid} {signalStrength}%",
        "format-ethernet": " {ifname}",
        "format-linked": " (no ip)",
        "format-disconnected": "⚠ offline",
        "tooltip-format": "{ipaddr}/{cidr}  ·  {gwaddr}"
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "🔇",
        "format-icons": {"default": ["🔈", "🔉", "🔊"]},
        "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle"
    },

    "temperature": {
        "critical-threshold": 85,
        "format": "🌡 {temperatureC}°C"
    },

    "tray": {
        "spacing": 8,
        "icon-size": 16
    }
}
