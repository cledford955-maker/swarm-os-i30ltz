[Unit]
Description=DR. I30LTZ Recovery — Evaluation System
# Must not start before the API keys are unsealed into /run.
After=swarm-secrets.service
Wants=swarm-secrets.service
# Not auto-started; launched on-demand from SWARM OS, Endeavor, or CachyOS
# Reads /mnt/boltz/Lucille-AI as reference; connects to LucyServer /boltz for AI
After=graphical.target

[Service]
Type=simple
User=swarm
# Secrets live only in tmpfs, unsealed at boot by swarm-secrets.service.
# The leading '-' is deliberate: an ISO built with no keys, or one where
# the passphrase was skipped, still starts — the service reports AI
# features unavailable instead of refusing to run.
EnvironmentFile=-/run/swarm_os.env
Environment=DISPLAY=:0
Environment=WAYLAND_DISPLAY=wayland-0
Environment=XDG_RUNTIME_DIR=/run/user/1000
ExecStart=/opt/swarm_os/i30ltz-recovery
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical.target
