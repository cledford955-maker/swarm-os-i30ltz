[Unit]
Description=SWARM OS Sealed Secrets (unseal API keys into /run)
Documentation=file:///etc/swarm_os.env.manifest
DefaultDependencies=no
After=systemd-tmpfiles-setup.service local-fs.target
Before=lucy-server.service gaming-agent.service google-workspace.service i30ltz-recovery.service
Before=shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/swarm-unseal-secrets
# The unsealer never exits non-zero for a missing or unopened blob — an ISO
# with no keys is a valid ISO. Only a genuinely broken image fails here.
StandardOutput=journal
StandardError=journal
TimeoutStartSec=180
# /run/swarm_os.env is tmpfs: keys exist only while the machine is powered on.
ExecStopPost=/usr/bin/rm -f /run/swarm_os.env

[Install]
WantedBy=multi-user.target
