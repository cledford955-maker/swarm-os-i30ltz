[Unit]
Description=SWARM OS Lucille Core engine (HITL approvals to companion phones on :9091)
# SWARM_AUTH_TOKEN comes from the sealed secrets; without it the engine runs
# but keeps the companion socket off and denies every HITL approval.
After=swarm-secrets.service network-online.target tailscaled.service
Wants=swarm-secrets.service network-online.target
StartLimitBurst=3
StartLimitIntervalSec=60

[Service]
Type=simple
User=swarm
RuntimeDirectory=lucille
WorkingDirectory=/run/lucille
# The :9091 socket binds the Tailscale address once at start (loopback if it
# isn't up yet, which phones can't reach). Give tailscale0 up to 30 s to get
# an IPv4 address; never fail the start over it.
ExecStartPre=/bin/sh -c 'for i in $(seq 30); do ip -4 -o addr show dev tailscale0 2>/dev/null | grep -q inet && exit 0; sleep 1; done; exit 0'
ExecStart=/usr/bin/lucille-core --socket /run/lucille/ipc.sock --telemetry-port 9091
Restart=on-failure
RestartSec=5
EnvironmentFile=-/run/swarm_os.env

[Install]
WantedBy=multi-user.target
