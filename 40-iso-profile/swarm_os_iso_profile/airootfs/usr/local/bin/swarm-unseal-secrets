#!/usr/bin/env bash
# =============================================================================
# swarm-unseal-secrets — SWARM OS first-boot secret unseal  v1.0.0 · 2026-09-12
#
# The ISO ships /etc/swarm_os.env.gpg (AES-256) and no plaintext. This unseals
# it into /run/swarm_os.env — tmpfs, mode 0640, root:swarm — which is where
# every SWARM service reads its keys from. Nothing is ever written back to disk.
#
# Passphrase, first source that works wins:
#   1. $SWARM_SECRETS_KEYFILE, if set and readable
#   2. swarm-secrets.key on any mounted removable volume or the boltz drive
#   3. an interactive prompt (systemd-ask-password, or the tty when run by hand)
#
# Exit 0 also covers "no blob present" — an ISO built without secrets is a
# legitimate build, and the OS runs with AI features disabled rather than
# refusing to boot. Check `systemctl status swarm-secrets` to see which it was.
# =============================================================================
set -uo pipefail

BLOB="${SWARM_SECRETS_BLOB:-/etc/swarm_os.env.gpg}"
TARGET="${SWARM_SECRETS_TARGET:-/run/swarm_os.env}"
MANIFEST="/etc/swarm_os.env.manifest"
TRIES="${SWARM_SECRETS_TRIES:-3}"

log() { echo "[swarm-secrets] $*"; }

if [ ! -f "$BLOB" ]; then
    log "no sealed secrets at $BLOB — starting with no API keys."
    log "AI features will report themselves unavailable. This is a clean build, not a fault."
    : > "$TARGET"; chmod 0640 "$TARGET"; chown root:swarm "$TARGET" 2>/dev/null
    exit 0
fi

if [ -s "$TARGET" ]; then
    log "secrets already unsealed at $TARGET — nothing to do."
    exit 0
fi

command -v gpg >/dev/null 2>&1 || { log "FATAL: gpg is missing from this image"; exit 1; }

unseal_with() {
    local passfile="$1" out
    out="$(mktemp -p /run -t .swarm-unseal-XXXXXX)" || return 1
    chmod 0600 "$out"
    if gpg --batch --quiet --decrypt --pinentry-mode loopback \
           --passphrase-file "$passfile" "$BLOB" > "$out" 2>/dev/null && [ -s "$out" ]; then
        install -m 0640 -o root -g swarm "$out" "$TARGET" 2>/dev/null \
            || install -m 0600 "$out" "$TARGET"
        rm -f "$out"
        return 0
    fi
    rm -f "$out"
    return 1
}

# --- 1. explicit keyfile ------------------------------------------------------
if [ -n "${SWARM_SECRETS_KEYFILE:-}" ] && [ -r "$SWARM_SECRETS_KEYFILE" ]; then
    if unseal_with "$SWARM_SECRETS_KEYFILE"; then
        log "unsealed using SWARM_SECRETS_KEYFILE"
        exit 0
    fi
    log "SWARM_SECRETS_KEYFILE did not unseal the blob — falling through"
fi

# --- 2. key file on a mounted volume -----------------------------------------
for cand in /mnt/boltz/swarm-secrets.key \
            /mnt/brains/swarm-secrets.key \
            /run/media/*/swarm-secrets.key \
            /mnt/*/swarm-secrets.key; do
    [ -r "$cand" ] || continue
    if unseal_with "$cand"; then
        log "unsealed using key file $cand"
        exit 0
    fi
done

# --- 3. ask a human -----------------------------------------------------------
PASSFILE="$(mktemp -p /run -t .swarm-pass-XXXXXX)" || exit 1
chmod 0600 "$PASSFILE"
trap 'rm -f "$PASSFILE"' EXIT

for attempt in $(seq 1 "$TRIES"); do
    if command -v systemd-ask-password >/dev/null 2>&1 && [ ! -t 0 ]; then
        systemd-ask-password --timeout=120 --no-tty \
            "SWARM OS — passphrase to unseal API keys (attempt $attempt/$TRIES, Enter to skip):" \
            > "$PASSFILE" 2>/dev/null
    else
        read -rsp "SWARM OS secrets passphrase (attempt $attempt/$TRIES, Enter to skip): " p < /dev/tty
        echo
        printf '%s' "$p" > "$PASSFILE"
        unset p
    fi

    if [ ! -s "$PASSFILE" ]; then
        log "no passphrase given — continuing without API keys."
        : > "$TARGET"; chmod 0640 "$TARGET"; chown root:swarm "$TARGET" 2>/dev/null
        exit 0
    fi

    if unseal_with "$PASSFILE"; then
        n=$(grep -cE '^[A-Za-z_][A-Za-z0-9_]*=' "$TARGET" 2>/dev/null || echo 0)
        log "unsealed $n variables into $TARGET"
        exit 0
    fi
    log "wrong passphrase"
done

log "could not unseal after $TRIES attempts — continuing without API keys."
[ -f "$MANIFEST" ] && log "sealed keys are listed by name in $MANIFEST"
log "retry later with: sudo systemctl restart swarm-secrets.service"
: > "$TARGET"; chmod 0640 "$TARGET"; chown root:swarm "$TARGET" 2>/dev/null
exit 0
